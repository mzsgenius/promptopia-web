// PrompTopia — Prisma Schema V1
// Database: Supabase PostgreSQL
// Migrations: npx prisma migrate dev
// Runtime:    uses Supabase connection pooler (port 6543)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── User (synced from Supabase Auth) ──────────────
model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  name       String?
  email      String?  @unique
  avatar     String?
  role       String   @default("user")    // "user" | "admin"
  banned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cases     Case[]
  likes     CaseLike[]
  bookmarks CaseBookmark[]
  comments  Comment[]
}

// ── Case — core data object ────────────────────────
model Case {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String                    // "ai-startup" | "ai-side-hustle" | ...
  tags        Json     @default("[]")   // ["Cursor","Claude","SaaS"]
  tools       Json     @default("[]")   // ["Cursor","Claude 3.5 Sonnet"]
  summary     String                    // 20-250 chars, SEO description
  content     String   @db.Text         // Markdown body

  // ── SEO enhancement fields (Day 3) ─────────────
  intent       String?                  // "副业" | "创业" | "自动化" | "学习" | "效率提升"
  resultType   String?                  // "收入" | "效率" | "技能" | "产品" | "流量"
  primaryTool  String?                  // 主要AI工具，用于seoKeywords聚合
  seoKeywords  Json     @default("[]")  // ["AI副业案例","Cursor开发","SaaS复盘"]

  // ── metrics ────────────────────────────────────
  timeSpent   Int?                      // hours
  income      Int?                      // monthly income in CNY
  workflow    Json?                     // [{step,title,tool,duration,desc}]
  lessons     String?  @db.Text         // 踩坑/教训
  projectLink String?
  coverUrl    String?
  difficulty  Int?                      // 1-5 scale
  status      String   @default("approved")  // "pending" | "approved" | "rejected"

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  viewCount    Int      @default(0)
  likeCount    Int      @default(0)
  bookmarkCount Int     @default(0)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes      CaseLike[]
  bookmarks  CaseBookmark[]
  comments   Comment[]

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([authorId])
}

// ── Case Like ──────────────────────────
model CaseLike {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
}

// ── Case Bookmark ──────────────────────
model CaseBookmark {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
}

// ── Comment ────────────────────────────
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  caseId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

// ── PageView (site-wide analytics) ──────
model PageView {
  id        String   @id @default(cuid())
  date      String   @default("")       // YYYY-MM-DD
  path      String   @default("/")
  ip        String?                     // 访客 IP 地址
  userId    String?                     // 登录用户的 Prisma User id
  userName  String?                     // 登录用户的昵称
  createdAt DateTime @default(now())

  @@unique([ip, date])
  @@index([date])
}

// ── License Product (e.g. "AI项目导师 · 专业版 ¥39.9") ──
model LicenseProduct {
  id        String   @id @default(cuid())
  name      String
  price     Int                         // price in fen (3990 = ¥39.9)
  duration  Int?                        // validity days, null = lifetime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders      Order[]      @relation("ProductOrders")
  licenseKeys LicenseKey[]
}

// ── Order (user submits WeChat payment info) ──────────
model Order {
  id            String   @id @default(cuid())
  productId     String
  userId        String?
  userName      String?
  userEmail     String?
  userContact   String?                 // WeChat ID / phone
  amount        Int                     // price in fen
  paymentMethod String?                 // "wechat"
  paymentProof  String?                 // WeChat transaction ID / screenshot URL
  status        String   @default("pending")  // "pending" | "approved" | "rejected"
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    LicenseProduct @relation(fields: [productId], references: [id], name: "ProductOrders")
  licenseKey LicenseKey?
}

// ── License Key (one-time use) ────────────────────────
model LicenseKey {
  id          String    @id @default(cuid())
  key         String    @unique
  productId   String
  orderId     String?   @unique
  userId      String?
  activated   Boolean   @default(false)
  activatedAt DateTime?
  deviceInfo  String?
  expiredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order?          @relation(fields: [orderId], references: [id])
  product LicenseProduct  @relation(fields: [productId], references: [id])
}
