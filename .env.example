# ── Supabase Auth ───────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Database (Supabase) ─────────────
# Pooled connection (port 6543) — for Prisma at runtime
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres"

# Direct connection (port 5432) — for Prisma migrations only
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ── Site URL ────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://promptopia.com"
